FROM soulter/astrbot@sha256:c93a6d19507ba45474c3dfb82aad9d36eb432a478112f13c7e6325b5ebffc5f2

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY runtime/requirements-controller.txt /app/requirements-controller.txt
RUN python -m venv /opt/office-controller-venv \
    && /opt/office-controller-venv/bin/pip install --no-cache-dir -r /app/requirements-controller.txt
COPY runtime/service /app/service

EXPOSE 8030
ENTRYPOINT ["/opt/office-controller-venv/bin/python", "-m", "uvicorn"]
CMD ["service.app:app", "--host", "0.0.0.0", "--port", "8030", "--workers", "1"]
