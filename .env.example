# 至少 32 字符；推荐执行 `openssl rand -hex 32` 生成，不要提交真实值。
OFFICE_RUNTIME_TOKEN=

# 必须是 Docker 宿主机上的绝对路径，并提前创建。控制器将同一路径挂载为 /data。
OFFICE_HOST_DATA_ROOT=/absolute/path/to/astrbot_plugin_minimax_office/runtime-data

# AstrBot 所在的已有 Docker 网络。默认 Compose 项目名为 astrbot 时通常是 astrbot_bot。
ASTRBOT_NETWORK=astrbot_bot

# 本项目只提供 Dockerfile，不发布预构建镜像；可按自己的镜像仓库规则改名。
OFFICE_WORKER_IMAGE=astrbot-minimax-office-worker:local
OFFICE_CONTROLLER_IMAGE=astrbot-minimax-office-runtime:local

# 宿主机诊断端口只绑定回环地址；AstrBot 容器始终使用 http://office-runtime:8030。
OFFICE_BIND_ADDRESS=127.0.0.1
OFFICE_PORT=8030
DOCKER_SOCKET_PATH=/var/run/docker.sock

OFFICE_OWNER_QUOTA_BYTES=209715200
OFFICE_GLOBAL_QUOTA_BYTES=2147483648
OFFICE_RETENTION_SECONDS=604800
